# Python cache files
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Jupyter temporary files
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE settings
.vscode/

# Operating system files
.DS_Store
Thumbs.db

# Testing and analysis caches
.pytest_cache/
.coverage
htmlcov/

# Temporary files and logs
*.tmp
*.log

# Generated Python package files
build/
dist/
*.egg-info/

# Protect raw or restricted survey data
/data/raw/*
!/data/raw/README.md

# Protect processed data that may contain household-level records
/data/processed/*

# Keep external source downloads out of Git
/data/external/*

# Allow documentation for data folders
!/data/README.md

# Keep the original analysis notebook private
/notebooks/02_dataset_assessment.ipynb

# Keep temporary notebook backups private
/notebooks/02_dataset_assessment_public_backup_*.ipynb

# Keep local dependency-file backups private
requirements.txt.backup